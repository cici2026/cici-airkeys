{
	"name": "airkeys-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Airkeys on the web: the site, and the online side of the Airkeys cold wallet — balances, transfer requests, broadcasting.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mondaylabsltd/airkeys",
		"directory": "app-web/airkeys.app"
	},
	"homepage": "https://github.com/mondaylabsltd/airkeys/tree/main/app-web/airkeys.app#readme",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"deploy": "bun run build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"extension": "node scripts/extension.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"vectors": "cd ../../core && cargo run -q --release -p airkeys-wallet --example vectors > ../app-web/airkeys.app/src/lib/vectors.json"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@scure/base": "2.4.0",
		"lumen-code": "github:atshelchin/lumen-code#4bc5f2bb1555cd40a10fb7da4ea9c8db018849c8",
		"uqr": "0.1.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "22",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.8",
		"wrangler": "^4.153.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
